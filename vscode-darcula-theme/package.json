{
  "name": "darcula-classic-py-lab",
  "displayName": "Py Darcula Classic Theme",
  "description": "An unofficial, cross-platform VS Code color theme inspired by the classic IntelliJ Darcula palette.",
  "version": "1.0.7",
  "publisher": "py-darcula-theme-lab",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "darcula",
    "intellij",
    "jetbrains",
    "dark theme",
    "color theme",
    "python",
    "java",
    "jetbrains mono"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "pricing": "Free",
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-python.vscode-pylance"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "validate": "node scripts/validate-theme.mjs",
    "package:vsix": "node scripts/validate-theme.mjs && vsce package --out dist/darcula-classic-py-lab-1.0.7.vsix",
    "list:vsix": "vsce ls"
  },
  "contributes": {
    "configurationDefaults": {
      "[python]": {
        "editor.inlayHints.enabled": "on",
        "editor.inlayHints.padding": true
      },
      "python.analysis.inlayHints.callArgumentNames": "all"
    },
    "themes": [
      {
        "label": "Py Darcula Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/darcula-classic-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
